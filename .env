# FoodBridge Environment Configuration

# Database Configuration
# Set DB_TYPE=mysql if your MySQL server is running and password is set
DB_TYPE=auto

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=foodbridge

# Application Secret Key
SECRET_KEY=foodbridge-smart-platform-2026-secret
FLASK_ENV=development
PORT=5000
